# Zkopíruj na .env a vyplň. .env je v .gitignore — nikdy ho necommituj.

# Heslo lokální databáze (libovolné, nikam neodchází)
POSTGRES_PASSWORD=change-me-locally

# Správce klíčů credential vaultu. Výchozí lokální keyset stačí pro self-host i vývoj;
# náš provoz používá aws-kms://arn:aws:kms:… (viz ADR 0008).
# VAULT_KEK_URI=local:///var/lib/appreviewzz/keyset

# Zálohy databáze. Výchozí cíl je volume v Dockeru; kdo má S3 (nebo MinIO), přepíše na
# s3://bucket/prefix a doplní AWS_* proměnné, případně BACKUP_S3_ENDPOINT pro jiné než AWS.
# BACKUP_TARGET=file:///var/backups/appreviewzz
# BACKUP_AT=02:30
# BACKUP_RETENTION_DAYS=30

# AI návrhy odpovědí. Výchozí `none` znamená prázdný vstup ve Slacku a odpověď píše člověk;
# náš cloud jede na Gemini kvůli paritě s dosavadním n8n řešením.
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# Slack App (F2). Bez signing secretu se interactivity endpoint vůbec nezaregistruje —
# odpovídat na recenze ze Slacku pak nejde. Self-host si zakládá vlastní Slack App
# (návod v docs/slack-app.md). CLIENT_ID/SECRET zapínají „Add to Slack" do cizích workspaců;
# do jednoho vlastního workspace se appka nainstaluje ručně a token vloží `slack connect`.
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# PUBLIC_BASE_URL=https://appreviewzz.example.com

# Microsoft Teams (F4). Jeden Azure Bot na celý deployment; klienti se liší jen tenantem,
# který se ukládá zašifrovaný příkazem `teams connect`. Bez APP_ID a hesla se messaging
# endpoint nezaregistruje a odpovídat z Teams nejde. TENANT_ID vyplň jen u single-tenant
# registrace; multi-tenant bot si o token říká přes botframework.com.
# Messaging endpoint bota nastav na {PUBLIC_BASE_URL}/webhooks/teams/messages.
# TEAMS_BOT_APP_ID=
# TEAMS_BOT_APP_PASSWORD=
# TEAMS_BOT_TENANT_ID=

# Console (F3). Odkazy v e-mailech (potvrzení adresy, obnova hesla, pozvánky) se skládají
# z domény, na které požadavek přišel — staging tedy posílá na staging a produkce na produkci
# bez dalšího nastavování. CONSOLE_BASE_URL je adresa, která se použije, když e-mail vzniká
# mimo požadavek (CLI, worker), a zároveň jediná doména, které se z požadavku věří: `Host`
# si posílá klient, takže bez toho filtru by šlo poslat odkaz na obnovu hesla mířící jinam.
# Obsluhuje-li jedno nasazení víc domén, přidej je do CONSOLE_ALLOWED_HOSTS (čárkou oddělené,
# `*.appreviewzz.com` sedí i na apex). Bez MAIL_SMTP_HOST se e-maily jen vypisují do logu,
# což pro první rozkoukání stačí, ale pozvánky pak musíš rozesílat ručně.
# CONSOLE_BASE_URL=https://console.appreviewzz.example.com
# CONSOLE_ALLOWED_HOSTS=console.appreviewzz.example.com,*.appreviewzz.example.com
# Bez MAIL_FROM se odesílatel odvodí z domény konzole; s opravdovým relayem sem patří adresa,
# na kterou sedí SPF/DKIM.
# MAIL_FROM=appreviewzz@example.com
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# MAIL_SMTP_STARTTLS=true
# Bez SMTP se e-maily jen vypisují do logu. Tělo (a v něm jednorázový odkaz, kterým jde
# změnit cizí heslo) se ale mimo lokální běh nevypisuje — zapni jen vědomě.
# MAIL_LOG_LINKS=false

# Limity požadavků a adresa klienta (F5). Výchozí hodnoty jsou nastavené tak, aby o nich
# běžná práce v konzoli nevěděla; vypínat je má smysl jen tam, kde totéž řeší reverzní proxy.
#
# TRUSTED_PROXY_HOPS říká, kolik proxy před námi stojí — podle toho se z X-Forwarded-For
# bere adresa klienta. Výchozí 1 odpovídá běžnému nasazení za jedním reverzním proxy;
# 0 nastav tam, kde aplikace visí na internetu přímo, jinak si adresu klienta určí kdokoli
# sám jednou hlavičkou.
# TRUSTED_PROXY_HOPS=1
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_API_PER_MINUTE=240
# RATE_LIMIT_AUTH_PER_5M=20
# RATE_LIMIT_AUTH_PER_IDENTITY=8
# RATE_LIMIT_WEBHOOK_PER_MINUTE=240

# Volitelné přepisy
# POSTGRES_DB=appreviewzz
# POSTGRES_USER=appreviewzz
# POSTGRES_PORT=5432
# API_PORT=8080
# APPREVIEWZZ_ENV=local
