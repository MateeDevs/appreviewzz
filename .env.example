# Zkopíruj na .env a vyplň. .env je v .gitignore — nikdy ho necommituj.

# Heslo lokální databáze (libovolné, nikam neodchází)
POSTGRES_PASSWORD=change-me-locally

# Správce klíčů credential vaultu. Výchozí lokální keyset stačí pro self-host i vývoj;
# náš provoz používá aws-kms://arn:aws:kms:… (viz ADR 0008).
# VAULT_KEK_URI=local:///var/lib/appreviewzz/keyset

# Zálohy databáze. Výchozí cíl je volume v Dockeru; kdo má S3 (nebo MinIO), přepíše na
# s3://bucket/prefix a doplní AWS_* proměnné, případně BACKUP_S3_ENDPOINT pro jiné než AWS.
# BACKUP_TARGET=file:///var/backups/appreviewzz
# BACKUP_AT=02:30
# BACKUP_RETENTION_DAYS=30

# AI návrhy odpovědí. Výchozí `none` znamená prázdný vstup ve Slacku a odpověď píše člověk;
# náš cloud jede na Gemini kvůli paritě s dosavadním n8n řešením.
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# Slack App (F2). Bez signing secretu se interactivity endpoint vůbec nezaregistruje —
# odpovídat na recenze ze Slacku pak nejde. Self-host si zakládá vlastní Slack App
# (návod v docs/slack-app.md). CLIENT_ID/SECRET zapínají „Add to Slack" do cizích workspaců;
# do jednoho vlastního workspace se appka nainstaluje ručně a token vloží `slack connect`.
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# PUBLIC_BASE_URL=https://appreviewzz.example.com

# Console (F3). CONSOLE_BASE_URL je adresa, na které konzoli vidí klient — skládají se z ní
# odkazy v e-mailech (potvrzení adresy, obnova hesla, pozvánky). Když chybí, použije se
# PUBLIC_BASE_URL. Bez MAIL_SMTP_HOST se e-maily jen vypisují do logu, což pro první
# rozkoukání stačí, ale pozvánky pak musíš rozesílat ručně.
# CONSOLE_BASE_URL=https://console.appreviewzz.example.com
# MAIL_FROM=appreviewzz@example.com
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# MAIL_SMTP_STARTTLS=true

# Volitelné přepisy
# POSTGRES_DB=appreviewzz
# POSTGRES_USER=appreviewzz
# POSTGRES_PORT=5432
# API_PORT=8080
# APPREVIEWZZ_ENV=local
