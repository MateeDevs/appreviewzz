<?xml version="1.0" encoding="UTF-8"?>
<!-- Produkční/kontejnerový formát: strukturované JSON logy pro CloudWatch/Loki. -->
<configuration>
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Redakce (F5.4). Encoder pouští tudy každou hodnotu — zprávu, stack trace
                 i vlastní pole — takže se nemusí vyjmenovávat, co všechno hlídat. -->
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <valueMasker class="cz.matee.appreviewzz.app.logging.RedactingValueMasker"/>
            </jsonGeneratorDecorator>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <customFields>{"service":"appreviewzz"}</customFields>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <!-- Ktor plugin MicrometerMetrics si při instalaci založí výchozí LoggingMeterRegistry,
         který jen ohlásí sám sebe. Náš Prometheus registry je jinde. -->
    <logger name="io.micrometer.core.instrument.push" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
