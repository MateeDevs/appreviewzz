{
  "name": "appreviewzz-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4327",
    "check": "astro check && tsc --noEmit -p tsconfig.tests.json",
    "build": "astro build",
    "build:production": "INDEXABLE=true astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4327",
    "test:browser": "playwright test",
    "capture": "node scripts/capture.mjs",
    "measure": "node scripts/lighthouse.mjs",
    "test:links": "node scripts/verify-links.mjs",
    "share-image": "node scripts/share-image.mjs",
    "test:zoom": "node scripts/zoom.mjs",
    "lint": "prettier --check src scripts tests astro.config.mjs playwright.config.ts tsconfig*.json package.json .prettierrc.json",
    "format": "prettier --write src scripts tests astro.config.mjs playwright.config.ts tsconfig*.json package.json .prettierrc.json"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "lighthouse": "13.5.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3"
  }
}
