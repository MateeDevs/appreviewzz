---
import { translator, type Locale } from '../i18n';
interface Props {
    locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = translator(locale);
import { getDemo } from '../data/demo';
const demo = getDemo(locale);
---

<div class="analysis-demo">
    <div class="analysis-top">
        <span>
            <span class="app-icon" aria-hidden="true">
                a<span>↗</span>
            </span>
            <strong>Atlas</strong>
            <span class="analysis-subtitle">{t('Review analysis')}</span>
        </span>
        <span>{demo.period}</span>
    </div>
    <div class="analysis-body">
        <div class="chart-heading">
            <div>
                <span class="small-label">{t('AFTER RELEASE 3.8')}</span>
                <h3>{t('What changed?')}</h3>
            </div>
            <span class="sample-tag">{t('Sample data')}</span>
        </div>
        <div class="topic-head" aria-hidden="true">
            <span>{t('Topic')}</span>
            <span>{t('Previous week')}</span>
            <span>{t('This week')}</span>
        </div>
        <div class="topic-list" aria-label={t('Sample review topics')}>
            {demo.topics.map((topic, index) => (
                <button
                    type="button"
                    class:list={['topic-row', { selected: index === 0 }]}
                    data-topic={topic.id}
                    aria-pressed={index === 0}
                    aria-controls="source-reviews"
                    aria-label={t(
                        '{topic}, {direction}: {previous} reviews previous week, {count} this week. Show source reviews.',
                        {
                            topic: topic.label,
                            direction: t(topic.direction).toLowerCase(),
                            previous: topic.previous,
                            count: topic.count,
                        },
                    )}
                    disabled
                >
                    <span>
                        <strong>{topic.label}</strong>
                        <span class:list={['topic-trend', topic.direction.toLowerCase()]}>
                            {topic.direction === 'Growing'
                                ? '↗'
                                : topic.direction === 'Falling'
                                  ? '↘'
                                  : '→'}{' '}
                            {t(topic.direction)}
                        </span>
                    </span>
                    <span class="topic-value">
                        <span
                            class="bar previous"
                            style={`--bar:${(topic.previous / 12) * 100}%`}
                        ></span>
                        <span>{topic.previous}</span>
                    </span>
                    <span class="topic-value">
                        <span class="bar" style={`--bar:${(topic.count / 12) * 100}%`}></span>
                        <span>{topic.count}</span>
                    </span>
                </button>
            ))}
        </div>
        <p class="chart-note">
            {t(
                'Number of text reviews mentioning each topic. One review can mention several topics.',
            )}
        </p>
        <div class="source-reviews" id="source-reviews" tabindex="-1">
            <div class="source-heading" aria-live="polite" aria-atomic="true">
                <h4 id="source-title">{t('Behind “{topic}”', { topic: demo.topics[0].label })}</h4>
                <span id="source-count">
                    {t('{shown} of {count} sample reviews', {
                        shown: demo.topics[0].reviews.length,
                        count: demo.topics[0].count,
                    })}
                </span>
            </div>
            <div id="source-list">
                {demo.topics[0].reviews.map((review) => (
                    <blockquote>
                        <div>
                            <span
                                class="source-stars"
                                aria-label={t('{stars} out of 5 stars', { stars: review.stars })}
                            >
                                {'★'.repeat(review.stars)}
                                <span aria-hidden="true">{'☆'.repeat(5 - review.stars)}</span>
                            </span>
                            <span>
                                {review.platform} · {review.date}
                            </span>
                        </div>
                        <p>{review.text}</p>
                    </blockquote>
                ))}
            </div>
        </div>
        <p class="analysis-fallback">
            {t('Select a topic to read the feedback behind it.')}{' '}
            <noscript>
                {' '}
                {t(
                    'Topic switching needs JavaScript; the offline-access sample reviews are shown above.',
                )}
            </noscript>
        </p>
    </div>
</div>
<script>
    import { getDemo } from '../data/demo';
    import { pageLocale, translator } from '../i18n';
    const t = translator(pageLocale());
    const demo = getDemo(pageLocale());
    document.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () => {
            const topic = demo.topics.find((item) => item.id === button.dataset.topic)!;
            document.querySelectorAll('[data-topic]').forEach((item) => {
                item.classList.toggle('selected', item === button);
                item.setAttribute('aria-pressed', String(item === button));
            });
            document.querySelector('#source-title')!.textContent = t('Behind “{topic}”', {
                topic: topic.label,
            });
            document.querySelector('#source-count')!.textContent = t(
                '{shown} of {count} sample reviews',
                { shown: topic.reviews.length, count: topic.count },
            );
            const list = document.querySelector('#source-list')!;
            list.replaceChildren(
                ...topic.reviews.map((review) => {
                    const quote = document.createElement('blockquote');
                    const meta = document.createElement('div');
                    const stars = document.createElement('span');
                    stars.className = 'source-stars';
                    stars.setAttribute(
                        'aria-label',
                        t('{stars} out of 5 stars', { stars: review.stars }),
                    );
                    stars.textContent = '★'.repeat(review.stars) + '☆'.repeat(5 - review.stars);
                    const platform = document.createElement('span');
                    platform.textContent = `${review.platform} · ${review.date}`;
                    meta.append(stars, platform);
                    const text = document.createElement('p');
                    text.textContent = review.text;
                    quote.append(meta, text);
                    return quote;
                }),
            );
        });
    });
</script>
