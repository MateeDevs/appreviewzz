---
import { translator, type Locale } from '../i18n';
import Icon from './Icon.astro';
import { integrations, statusLabel, type Integration } from '../data/integrations';
import { site } from '../data/site';
import '../styles/integrations.css';
interface Props {
    items?: Integration[];
    locale?: Locale;
}
const { items = integrations, locale = 'en' } = Astro.props;
const t = translator(locale);
---

<section
    class="integrations-section section container"
    id="integrations"
    aria-labelledby="integrations-title"
>
    <div class="section-intro">
        <p class="eyebrow">{t('INTEGRATIONS · A TWO-WAY CONVERSATION')}</p>
        <h2 id="integrations-title">
            {t('Your channel.')} <br /> {t('The whole conversation.')}
        </h2>
        <p>
            {t(
                'Reviews come in. Considered replies go back out. Explore each integration and its current availability.',
            )}
        </p>
    </div>
    <div class="integration-explorer" data-integrations>
        <div class="integration-sidebar" hidden>
            <div
                class="integration-tabs"
                role="tablist"
                aria-label={t('Explore integrations')}
                aria-orientation="vertical"
            >
                {items.map((item, index) => (
                    <button
                        type="button"
                        role="tab"
                        id={`integration-tab-${item.id}`}
                        aria-controls={`integration-${item.id}`}
                        aria-selected={index === 0}
                        tabindex={index === 0 ? 0 : -1}
                        data-integration-tab={item.id}
                    >
                        <span class="integration-logo">
                            <Icon name={item.icon} size={28} />
                        </span>
                        <span>
                            <strong>{item.name}</strong>
                            <span class:list={['availability', item.status]}>
                                {t(statusLabel(item.status))}
                            </span>
                        </span>
                        <span class="integration-tab-arrow" aria-hidden="true">
                            ↗
                        </span>
                    </button>
                ))}
            </div>
            <p class="integration-more">
                {t('More integrations coming soon.')} <br />
                <a href={site.contact}>
                    {' '}
                    {t('Tell us where your team works')} <span aria-hidden="true">↗</span>
                </a>
            </p>
        </div>
        <div class="integration-panels">
            {items.map((item, index) => (
                <details
                    class="integration-panel"
                    id={`integration-${item.id}`}
                    name="integration-preview"
                    open={index === 0}
                    data-integration-panel={item.id}
                    data-availability={item.status}
                >
                    <summary>
                        <Icon name={item.icon} size={24} />
                        <h3>{item.name}</h3>
                        <span class:list={['availability', item.status]}>
                            {t(statusLabel(item.status))}
                        </span>
                        <Icon name="plus" size={16} />
                    </summary>
                    <div class="integration-panel-content">
                        <div class="integration-panel-heading">
                            <div>
                                <p class="eyebrow">
                                    {item.status === 'coming-soon'
                                        ? t('IN PREPARATION')
                                        : t('READY FOR YOUR TEAM')}
                                </p>
                                <h3>
                                    {item.directReply
                                        ? t('From review to reply.')
                                        : t('Bring feedback closer.')}
                                </h3>
                            </div>
                            <span class="integration-capability">
                                <Icon name={item.directReply ? 'check' : 'arrow'} size={15} />
                                {item.directReply
                                    ? `${t('Direct replies')}${item.status === 'coming-soon' ? t(' · planned') : ''}`
                                    : `${t('Review delivery')}${item.status === 'coming-soon' ? t(' · planned') : ''}`}
                            </span>
                        </div>
                        <p class="integration-description">{t(item.description)}</p>
                        {item.media?.length ? (
                            <div class="integration-gallery">
                                <div
                                    class="integration-gallery-controls"
                                    role="group"
                                    aria-label={t('{name} screenshots', { name: item.name })}
                                    hidden
                                >
                                    {item.media.map((media, mediaIndex) => (
                                        <button
                                            type="button"
                                            aria-pressed={mediaIndex === 0}
                                            data-gallery-select={mediaIndex}
                                        >
                                            {mediaIndex + 1}. {t(media.caption)}
                                        </button>
                                    ))}
                                </div>
                                {item.media.map((media, mediaIndex) => (
                                    <figure
                                        class="integration-figure"
                                        data-gallery-image={mediaIndex}
                                    >
                                        <div
                                            class="integration-media"
                                            style={`--media-ratio: ${media.width} / ${media.height}`}
                                            data-media
                                            data-caption={
                                                item.status === 'coming-soon'
                                                    ? `${t('Planned integration preview · ')}${t(media.caption)}`
                                                    : t(media.caption)
                                            }
                                        >
                                            <div class="integration-image-fallback">
                                                <Icon name={item.icon} size={32} />
                                                <strong>{t('Preview unavailable')}</strong>
                                                <span>
                                                    {' '}
                                                    {t(
                                                        'This screenshot could not be loaded. Integration availability is unchanged.',
                                                    )}{' '}
                                                </span>
                                            </div>
                                            <img
                                                src={media.src}
                                                alt={t(media.alt)}
                                                width={media.width}
                                                height={media.height}
                                                loading="lazy"
                                                decoding="async"
                                            />
                                            <button
                                                type="button"
                                                class="integration-enlarge"
                                                data-enlarge
                                                hidden
                                                aria-label={t(
                                                    'Enlarge {name} screenshot: {caption}',
                                                    { name: item.name, caption: t(media.caption) },
                                                )}
                                            >
                                                {' '}
                                                {t('View full size')}{' '}
                                                <span aria-hidden="true">↗</span>
                                            </button>
                                        </div>
                                        <figcaption>
                                            {item.status === 'coming-soon' && (
                                                <span>{t('Planned integration preview · ')}</span>
                                            )}
                                            {t(media.caption)}
                                            <a class="integration-original" href={media.src}>
                                                {t('Open original screenshot')}{' '}
                                                <span aria-hidden="true">↗</span>
                                            </a>
                                        </figcaption>
                                    </figure>
                                ))}
                            </div>
                        ) : (
                            <div class="integration-empty">
                                <div class="integration-route" aria-hidden="true">
                                    <span>
                                        <Icon name="apple" size={20} />
                                        <Icon name="play" size={20} />
                                    </span>
                                    <span class="route-line">{item.directReply ? '↔' : '→'}</span>
                                    <span class="route-destination">
                                        <Icon name={item.icon} size={36} />
                                    </span>
                                </div>
                                <strong>
                                    {item.status === 'available'
                                        ? t('Preview coming soon')
                                        : t('{name} is coming soon', { name: item.name })}
                                </strong>
                                <p>
                                    {item.status === 'available'
                                        ? t(
                                              'The integration is available. A real screenshot of the workflow will follow.',
                                          )
                                        : t(
                                              'We’re getting this integration ready. A real preview will follow.',
                                          )}
                                </p>
                                <span class="integration-empty-note">
                                    {item.directReply
                                        ? t('Review in. Human-approved reply out.')
                                        : t('Planned review delivery. No direct replies yet.')}
                                </span>
                            </div>
                        )}
                        <p class="integration-panel-note">
                            {item.status === 'coming-soon'
                                ? t('Not yet available to connect. No release date announced.')
                                : t(
                                      'Connect through appreviewzz. Store and workspace permissions are required.',
                                  )}
                        </p>
                    </div>
                </details>
            ))}
        </div>
    </div>
    <div class="integration-follow-through">
        <span class="eyebrow">{t('THE REPLY PATH')}</span>
        <p>
            {t('New review')} <span>→</span> {t('AI draft')} <span>→</span>{' '}
            {t('Edit & approve in chat')} <span>→</span> {t('Queued for the store')} <span>→</span>{' '}
            {t('Published reply')}
        </p>
        <small>
            {' '}
            {t(
                'For integrations with direct replies, once available. Queued doesn’t mean published: the message updates after a successful send; store errors need attention.',
            )}{' '}
        </small>
    </div>
    <p class="integration-disclaimer">
        {t(
            'Integration names identify the tools we’re building for, not customer endorsements or official partnerships.',
        )}
    </p>
    <dialog class="integration-dialog" aria-labelledby="integration-dialog-title">
        <div class="integration-dialog-header">
            <h3 id="integration-dialog-title">{t('Integration screenshot')}</h3>
            <button type="button" data-close-preview autofocus>
                {t('Close')} <span aria-hidden="true">×</span>
            </button>
        </div>
        <p class="integration-dialog-hint">
            {t('Full-size image · Scroll to explore the details.')}
        </p>
        <div
            class="integration-dialog-image"
            role="region"
            aria-label={t('Full-size screenshot')}
            tabindex="0"
        ></div>
        <p class="integration-dialog-caption"></p>
    </dialog>
</section>
<script>
    const explorer = document.querySelector<HTMLElement>('[data-integrations]');
    if (explorer) {
        const tabs = [...explorer.querySelectorAll<HTMLButtonElement>('[data-integration-tab]')];
        // Native disclosures remain usable without JS. Upgrade to div-based tabpanels:
        // details itself cannot take the ARIA tabpanel role.
        const panels = [
            ...explorer.querySelectorAll<HTMLDetailsElement>('[data-integration-panel]'),
        ].map((details, index) => {
            const panel = document.createElement('div');
            for (const attribute of [...details.attributes]) {
                if (attribute.name !== 'name' && attribute.name !== 'open')
                    panel.setAttribute(attribute.name, attribute.value);
            }
            details.querySelector('summary')!.remove();
            panel.append(...details.childNodes);
            panel.setAttribute('role', 'tabpanel');
            panel.setAttribute('aria-labelledby', tabs[index].id);
            panel.tabIndex = 0;
            details.replaceWith(panel);
            return panel;
        });
        explorer.querySelector<HTMLElement>('.integration-sidebar')!.hidden = false;
        const tablist = explorer.querySelector<HTMLElement>('[role="tablist"]')!;
        const mobile = matchMedia('(max-width: 700px)');
        const orientation = () =>
            tablist.setAttribute('aria-orientation', mobile.matches ? 'horizontal' : 'vertical');
        orientation();
        mobile.addEventListener('change', orientation);
        const activate = (index: number, moveFocus = false) => {
            tabs.forEach((tab, current) => {
                const active = current === index;
                tab.setAttribute('aria-selected', String(active));
                tab.tabIndex = active ? 0 : -1;
                panels[current].hidden = !active;
            });
            if (moveFocus) tabs[index].focus();
        };
        activate(0);
        tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => activate(index));
            tab.addEventListener('keydown', (event) => {
                let next: number;
                if (event.key === 'ArrowDown' || event.key === 'ArrowRight')
                    next = (index + 1) % tabs.length;
                else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft')
                    next = (index - 1 + tabs.length) % tabs.length;
                else if (event.key === 'Home') next = 0;
                else if (event.key === 'End') next = tabs.length - 1;
                else return;
                event.preventDefault();
                activate(next, true);
            });
        });
        explorer.querySelectorAll<HTMLElement>('.integration-gallery').forEach((gallery) => {
            const controls = gallery.querySelector<HTMLElement>('.integration-gallery-controls')!;
            const buttons = [...controls.querySelectorAll<HTMLButtonElement>('button')];
            const figures = [...gallery.querySelectorAll<HTMLElement>('[data-gallery-image]')];
            controls.hidden = buttons.length < 2;
            const select = (index: number) => {
                figures.forEach((figure, current) => {
                    figure.hidden = current !== index;
                });
                buttons.forEach((button, current) =>
                    button.setAttribute('aria-pressed', String(current === index)),
                );
            };
            select(0);
            buttons.forEach((button, index) =>
                button.addEventListener('click', () => select(index)),
            );
        });
        const dialog = document.querySelector<HTMLDialogElement>('.integration-dialog')!;
        let opener: HTMLButtonElement | undefined;
        dialog
            .querySelector('[data-close-preview]')!
            .addEventListener('click', () => dialog.close());
        dialog.addEventListener('close', () => {
            dialog.querySelector('.integration-dialog-image')!.replaceChildren();
            opener?.focus();
        });
        dialog.addEventListener('keydown', (event) => {
            if (event.key !== 'Tab') return;
            const close = dialog.querySelector<HTMLElement>('[data-close-preview]')!;
            const image = dialog.querySelector<HTMLElement>('.integration-dialog-image')!;
            if (event.shiftKey && document.activeElement === close) {
                event.preventDefault();
                image.focus();
            } else if (!event.shiftKey && document.activeElement === image) {
                event.preventDefault();
                close.focus();
            }
        });
        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
        });
        explorer.querySelectorAll<HTMLElement>('[data-media]').forEach((frame) => {
            const img = frame.querySelector<HTMLImageElement>('img')!;
            const enlarge = frame.querySelector<HTMLButtonElement>('[data-enlarge]')!;
            const update = () => {
                const ready = img.complete && img.naturalWidth > 0;
                frame.classList.toggle('media-ready', ready);
                img.hidden = img.complete && img.naturalWidth === 0;
                enlarge.hidden = !ready;
            };
            img.addEventListener('load', update);
            img.addEventListener('error', update);
            update();
            enlarge.addEventListener('click', () => {
                opener = enlarge;
                const copy = img.cloneNode() as HTMLImageElement;
                copy.loading = 'eager';
                copy.hidden = false;
                dialog.querySelector('.integration-dialog-image')!.replaceChildren(copy);
                dialog.querySelector('.integration-dialog-caption')!.textContent =
                    frame.dataset.caption!;
                dialog.showModal();
            });
        });
    }
</script>
