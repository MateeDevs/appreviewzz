---
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import ReviewDemo from '../components/ReviewDemo.astro';
import AnalysisDemo from '../components/AnalysisDemo.astro';
import Faq from '../components/Faq.astro';
import { site, indexable } from '../data/site';
import '../styles/global.css';
const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: site.name,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: site.origin,
    description: site.description,
    creator: { '@type': 'Organization', name: 'Matee', url: site.maker },
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{site.title}</title>
        <meta name="description" content={site.description} />
        <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
        <link rel="canonical" href={`${site.origin}/`} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="theme-color" content="#f5f4f0" />
        <link
            rel="preload"
            as="font"
            href="/fonts/geist-variable.woff2"
            type="font/woff2"
            crossorigin
        />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={site.title} />
        <meta property="og:description" content={site.description} />
        <meta property="og:url" content={`${site.origin}/`} />
        <meta property="og:image" content={`${site.origin}/og.png`} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="appreviewzz. App reviews. Answered. Understood. App Store and Google Play, with Slack and Microsoft Teams."
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={site.title} />
        <meta name="twitter:description" content={site.description} />
        <meta name="twitter:image" content={`${site.origin}/og.png`} />
        <meta name="twitter:image:alt" content="appreviewzz — App reviews. Answered. Understood." />
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    </head>
    <body>
        <a class="skip-link" href="#main">
            Skip to content
        </a>
        <header class="site-header container">
            <a href="/" aria-label="appreviewzz home">
                <Brand />
            </a>
            <nav class="desktop-nav" aria-label="Main navigation">
                <a href="#how-it-works">How it works</a>
                <a href="#understand">Understand your reviews</a>
                <a href="#faq">FAQ</a>
            </nav>
            <div class="header-actions">
                <a class="login-link" href={site.login}>
                    Log in <span aria-hidden="true">↗</span>
                </a>
                <a class="button header-cta" href={site.register}>
                    Get started <Icon name="arrow" size={16} />
                </a>
            </div>
            <details class="mobile-menu">
                <summary aria-label="Open navigation">
                    <Icon name="menu" />
                    <span>Menu</span>
                </summary>
                <nav aria-label="Mobile navigation">
                    <a href="#how-it-works">How it works</a>
                    <a href="#understand">Understand your reviews</a>
                    <a href="#faq">FAQ</a>
                    <a href={site.login}>Log in ↗</a>
                    <a href={site.register}>Get started ↗</a>
                </nav>
            </details>
        </header>
        <main id="main">
            <section class="hero container" aria-labelledby="hero-title">
                <div class="hero-copy">
                    <p class="eyebrow">
                        <span class="mini-line" aria-hidden="true"></span> A CLOSER CONNECTION TO
                        YOUR USERS
                    </p>
                    <h1 id="hero-title">
                        App reviews.
                        <br /> Answered.
                        <br />
                        <span>Understood.</span>
                    </h1>
                    <p class="hero-description">
                        Bring App Store and Google Play reviews into Slack or Microsoft Teams. Help
                        your team reply with care — and know what to improve next.
                    </p>
                    <div class="hero-actions">
                        <a class="button" href={site.register}>
                            Get started <Icon name="arrow" />
                        </a>
                        <a class="text-link" href="#demo">
                            Try the reply demo <span aria-hidden="true">↘</span>
                        </a>
                    </div>
                    <p class="hero-reassurance">
                        AI-drafted. Human-approved. Connected to your stores.
                    </p>
                </div>
                <ReviewDemo />
            </section>
            <div class="integration-strip container">
                <p>
                    Your stores. Your team.
                    <br />
                    <strong>One connected workflow.</strong>
                </p>
                <div class="integration-brands">
                    <span>
                        <Icon name="apple" size={25} />
                        App Store
                    </span>
                    <span>
                        <Icon name="play" size={25} />
                        Google Play
                    </span>
                    <span class="integration-connector" aria-hidden="true">
                        →
                    </span>
                    <span>
                        <Icon name="slack" size={25} />
                        Slack
                    </span>
                    <span>
                        <Icon name="teams" size={27} />
                        Microsoft Teams
                    </span>
                </div>
            </div>
            <section
                class="workflow section container"
                id="how-it-works"
                aria-labelledby="workflow-title"
            >
                <div class="section-intro">
                    <p class="eyebrow">FROM FEEDBACK TO FOLLOW-THROUGH</p>
                    <h2 id="workflow-title">
                        A review is the start
                        <br />
                        of a conversation.
                    </h2>
                    <p>
                        Keep the people who hear from your users close to the people building your
                        app.
                    </p>
                </div>
                <div class="workflow-grid">
                    <article class="workflow-step">
                        <div class="step-top">
                            <span>01</span>
                            <svg viewBox="0 0 120 70" aria-hidden="true">
                                <path d="M5 35h35m40 0h35M40 35l20-18 20 18-20 18-20-18Z" />
                                <circle cx="60" cy="35" r="6" />
                            </svg>
                        </div>
                        <h3>Meet reviews where you work.</h3>
                        <p>
                            No more relying on someone to check both stores. New reviews arrive in
                            the Slack or Teams channel your team already follows.
                        </p>
                        <span class="step-detail">App Store + Google Play → your channel</span>
                    </article>
                    <article class="workflow-step">
                        <div class="step-top">
                            <span>02</span>
                            <svg viewBox="0 0 120 70" aria-hidden="true">
                                <path d="M30 15h55v40H30zM42 28h31M42 37h22m10 12 7 7 15-17" />
                            </svg>
                        </div>
                        <h3>
                            A thoughtful reply.
                            <br />
                            Still in your voice.
                        </h3>
                        <p>
                            Start with an AI draft, make it yours, then approve it for the store.
                            Use templates and translate drafts in the web inbox.
                        </p>
                        <span class="step-detail">Draft → edit → approve → store</span>
                    </article>
                    <article class="workflow-step">
                        <div class="step-top">
                            <span>03</span>
                            <svg viewBox="0 0 120 70" aria-hidden="true">
                                <path d="M20 53V38m20 15V28m20 25V15m20 38V23m20 30V9M15 61h91" />
                            </svg>
                        </div>
                        <h3>
                            See the pattern.
                            <br />
                            Find the next fix.
                        </h3>
                        <p>
                            Connect recurring topics to real reviews. See what changed after a
                            release and bring the evidence into your next product decision.
                        </p>
                        <a class="step-detail" href="#understand">
                            From the overview to the original review ↘
                        </a>
                    </article>
                </div>
            </section>
            <section class="insights-section" id="understand" aria-labelledby="insights-title">
                <div class="container insights-layout">
                    <div class="insights-copy">
                        <p class="eyebrow">LESS GUESSWORK. MORE CONTEXT.</p>
                        <h2 id="insights-title">
                            One review is a story.
                            <br />
                            <span>
                                Together, they show
                                <br />
                                you where to look.
                            </span>
                        </h2>
                        <p>
                            A new release goes out. Offline complaints start coming in. See the
                            topic, compare the change, then read the reviews behind it.
                        </p>
                        <ul class="insight-points">
                            <li>
                                <Icon name="check" />
                                Themes, sentiment and urgency in context
                            </li>
                            <li>
                                <Icon name="check" />
                                Release impact with a path to the evidence
                            </li>
                            <li>
                                <Icon name="check" />
                                Alerts for unusual negative-review spikes
                            </li>
                        </ul>
                        <div class="insight-aside">
                            <span aria-hidden="true">↳</span>
                            <p>
                                Explore the sample.
                                <br />
                                <strong>Select a topic to see its source reviews.</strong>
                            </p>
                        </div>
                    </div>
                    <AnalysisDemo />
                </div>
            </section>
            <section class="portfolio-section section container" aria-labelledby="portfolio-title">
                <div class="portfolio-copy">
                    <p class="eyebrow">ONE APP OR A WHOLE PORTFOLIO</p>
                    <h2 id="portfolio-title">
                        Keep the big picture.
                        <br />
                        Keep the details.
                    </h2>
                    <p>
                        Give your team a place to work across apps. Keep client organizations
                        separate. Make the next client conversation about what you learned.
                    </p>
                    <div class="portfolio-features">
                        <div>
                            <h3>Daily ratings, in perspective.</h3>
                            <p>
                                Follow store ratings and day-to-day changes separately from
                                sentiment in written reviews.
                            </p>
                        </div>
                        <div>
                            <h3>Client updates worth sharing.</h3>
                            <p>
                                Share a monthly review report and print it to PDF. Availability
                                depends on your plan.
                            </p>
                        </div>
                    </div>
                    <a class="text-link" href={site.contact}>
                        Let’s talk about your portfolio <Icon name="arrow" />
                    </a>
                </div>
                <div class="portfolio-visual">
                    <div class="portfolio-label">
                        <span>YOUR PORTFOLIO</span>
                        <span>Sample data</span>
                    </div>
                    <div
                        class="portfolio-table"
                        role="table"
                        aria-label="Sample application portfolio"
                    >
                        <div class="portfolio-table-head" role="row">
                            <span role="columnheader">Application</span>
                            <span role="columnheader">Needs a reply</span>
                            <span role="columnheader">Store rating</span>
                        </div>
                        {[
                            {
                                name: 'Atlas',
                                short: 'a',
                                type: 'Travel & maps',
                                count: 12,
                                rating: '4.6',
                                color: 'green',
                            },
                            {
                                name: 'Orbit',
                                short: 'o',
                                type: 'Focus & habits',
                                count: 4,
                                rating: '4.8',
                                color: 'violet',
                            },
                            {
                                name: 'Kompas',
                                short: 'k',
                                type: 'Local discovery',
                                count: 7,
                                rating: '4.4',
                                color: 'orange',
                            },
                        ].map((app) => (
                            <div class="portfolio-row" role="row">
                                <span role="cell">
                                    <span
                                        class:list={['portfolio-app', app.color]}
                                        aria-hidden="true"
                                    >
                                        {app.short}
                                    </span>
                                    <span>
                                        <strong>{app.name}</strong>
                                        <small>{app.type}</small>
                                    </span>
                                </span>
                                <span role="cell">
                                    {app.count}
                                    <small>reviews</small>
                                </span>
                                <span role="cell">
                                    {app.rating}
                                    <span class="rating-star" aria-hidden="true">
                                        ★
                                    </span>
                                    <small>App Store</small>
                                </span>
                            </div>
                        ))}
                    </div>
                    <div class="report-slip">
                        <span class="report-icon" aria-hidden="true">
                            ↗
                        </span>
                        <div>
                            <strong>Atlas · September review report</strong>
                            <span>A shared view for your next client conversation.</span>
                        </div>
                        <span class="report-type">PDF</span>
                    </div>
                    <p class="portfolio-note">
                        Illustrative portfolio · Store ratings and reply counts are separate
                        measures.
                    </p>
                </div>
            </section>
            <section class="reply-reason container" aria-labelledby="reason-title">
                <div class="quote-mark" aria-hidden="true">
                    “
                </div>
                <div>
                    <p class="eyebrow">THERE’S A PERSON BEHIND THE STARS</p>
                    <h2 id="reason-title">
                        A good reply keeps
                        <br />
                        the conversation open.
                    </h2>
                    <p>
                        Apple notifies reviewers when you respond, and they can update their review.
                        A reply is a chance to acknowledge a problem, offer help, or follow up on a
                        fix.
                    </p>
                    <a
                        class="source-link"
                        href="https://developer.apple.com/app-store/ratings-and-reviews/"
                    >
                        Source: Apple · Ratings, reviews, and responses{' '}
                        <span aria-hidden="true">↗</span>
                    </a>
                </div>
                <div class="reason-note">
                    <span class="small-label">OUR APPROACH</span>
                    <p>
                        Help your team respond well.
                        <br />
                        <strong>
                            Let the feedback inform
                            <br />
                            what comes next.
                        </strong>
                    </p>
                    <span>
                        No promised rating uplift.
                        <br />
                        Just a better feedback loop.
                    </span>
                </div>
            </section>
            <section class="setup-section section container" aria-labelledby="setup-title">
                <div class="setup-heading">
                    <p class="eyebrow">A CLEAR PATH TO YOUR FIRST REPLY</p>
                    <h2 id="setup-title">Connect. Choose. Start listening.</h2>
                </div>
                <ol class="setup-steps">
                    <li>
                        <span class="setup-number">1</span>
                        <div>
                            <h3>Connect your app.</h3>
                            <p>
                                Add your App Store or Google Play app and connect the store
                                permissions you need.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="setup-number">2</span>
                        <div>
                            <h3>Choose your channel.</h3>
                            <p>
                                Connect Slack or Microsoft Teams, choose a channel and send a test
                                message.
                            </p>
                        </div>
                    </li>
                    <li>
                        <span class="setup-number">3</span>
                        <div>
                            <h3>Make feedback a habit.</h3>
                            <p>
                                Review the next draft with your team. Keep an eye on the patterns as
                                feedback arrives.
                            </p>
                        </div>
                    </li>
                </ol>
                <p class="setup-help">
                    Want a hand with your setup?{' '}
                    <a href={site.contact}>
                        We’re here to help <span aria-hidden="true">↗</span>
                    </a>
                </p>
            </section>
            <Faq />
            <section class="final-cta container" aria-labelledby="cta-title">
                <div>
                    <p class="eyebrow">EVERY REVIEW IS FEEDBACK.</p>
                    <h2 id="cta-title">
                        Give it a place
                        <br />
                        in your team.
                    </h2>
                    <p>Start a closer conversation with your app’s users.</p>
                </div>
                <div class="final-actions">
                    <a class="button button-light" href={site.register}>
                        Get started with appreviewzz <Icon name="arrow" />
                    </a>
                    <a href={site.contact}>
                        Managing apps for clients? Let’s talk <span aria-hidden="true">↗</span>
                    </a>
                    <span>App Store & Google Play · Slack & Microsoft Teams</span>
                </div>
                <svg class="cta-art" viewBox="0 0 500 500" aria-hidden="true">
                    <g fill="none" stroke="currentColor">
                        {[100, 150, 200, 250].map((r) => (
                            <circle cx="250" cy="250" r={r} />
                        ))}
                    </g>
                    <path
                        d="M0 250h150l25-35 30 75 35-140 35 200 30-100h195"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    />
                </svg>
            </section>
        </main>
        <footer class="site-footer container">
            <div class="footer-main">
                <a href="/" aria-label="appreviewzz home">
                    <Brand />
                </a>
                <p>
                    Stay close to your users.
                    <br />
                    Build with their feedback.
                </p>
                <nav aria-label="Footer">
                    <a href={site.login}>Log in ↗</a>
                    <a href={site.contact}>{site.email}</a>
                    <a href={site.maker}>Made by Matee ↗</a>
                </nav>
            </div>
            <div class="footer-bottom">
                <span>© {new Date().getFullYear()} appreviewzz · Made with care by Matee.</span>
                <span>Store and workspace names belong to their respective owners.</span>
            </div>
        </footer>
        <script>
            document.documentElement.classList.add('js');
            const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu')!;
            menu.querySelectorAll('a').forEach((link) =>
                link.addEventListener('click', () => {
                    menu.open = false;
                }),
            );
            menu.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    menu.open = false;
                    menu.querySelector<HTMLElement>('summary')!.focus();
                }
            });
            document.addEventListener('click', (event) => {
                if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
            });
        </script>
    </body>
</html>
